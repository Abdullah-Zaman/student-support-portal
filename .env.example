APP_NAME="SE Department - Student Support Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://student-support-portal.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4. See the README for the local (Herd) database name/user.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=student_support_portal
DB_USERNAME=portal_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Database-backed queue. Applications/announcements/notifications are
# queued — `composer run dev` already runs a `queue:listen` worker
# alongside the server. See the README for production (Supervisor).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Mail — development (Mailtrap)
# --------------------------------------------------------------------------
# Create a free inbox at mailtrap.io, open its SMTP settings, and paste
# the host/port/username/password it gives you below.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="zeeshan.ahmed@superior.edu.pk"
MAIL_FROM_NAME="SE Department - Student Support"
MAIL_REPLY_TO_ADDRESS="noreply@superior.edu.pk"

# --------------------------------------------------------------------------
# Mail — production (Gmail / Google Workspace App Password) — reference only
# --------------------------------------------------------------------------
# 1. In the Google Workspace account, enable 2-Step Verification, then
#    create an "App Password" (Google Account > Security > App passwords).
# 2. Use that 16-character app password below — never the real account
#    password.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=zeeshan.ahmed@superior.edu.pk
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM_ADDRESS="zeeshan.ahmed@superior.edu.pk"
# MAIL_FROM_NAME="SE Department - Student Support"

# When set, and APP_ENV is not "production", every outgoing email is
# redirected to this one address instead of its real recipient — a
# safety net for any non-production environment pointed at a real SMTP
# provider (e.g. a staging server using the Gmail settings above).
# Leave blank in production.
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Student registration rules
# --------------------------------------------------------------------------
# The registration number format, e.g. SU92-BSSEM-F22-171. {programs} is
# replaced by the active program codes from the database. Capture group 1
# is the program code, group 2 is the batch (F22, S23...).
STUDENT_REGISTRATION_NO_PATTERN='/^SU\d{2}-({programs})[ME]-([FS]\d{2})-\d{1,4}$/'
STUDENT_EMAIL_DOMAIN="@superior.edu.pk"
STUDENT_EMAIL_MATCHES_REGISTRATION_NO=true

# --------------------------------------------------------------------------
# Seeded accounts (local/demo only — override for any real environment)
# --------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@superior.edu.pk
SEED_SUPER_ADMIN_PASSWORD=Password123!
SEED_ADMIN_OFFICER_EMAIL=admin.se@superior.edu.pk
SEED_ADMIN_OFFICER_PASSWORD=Password123!
